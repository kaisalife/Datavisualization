# =============================================================================
# DataVisualServer 环境变量样例
# =============================================================================
# 用法：
#   1. cp .env.example .env
#   2. 按需替换为真实值
#   3. 切勿将真实 .env 提交到 git（已在 .gitignore 中排除 *.env）
#
# 注意：
#   - 所有变量名保持与现有源码中 os.getenv(...) 调用一致，避免破坏向后兼容
#   - 标记 [现用] 的变量当前已被代码读取
#   - 标记 [待接] 的变量是任务 I6 将要接入的（参见 plan_claude.md）
#   - 标记 [可选] 的变量有合理默认值，可省略
# =============================================================================


# -----------------------------------------------------------------------------
# LLM 服务（主模型 - infini-ai）
# 参考：test_env/test_plan.py 通过请求体字段传入；service_main 内部如需默认值可用这些
# -----------------------------------------------------------------------------
# [现用] infini-ai maas 网关地址
BASE_URL="https://cloud.infini-ai.com/maas/coding"
# [现用] infini-ai API Key
API_KEY="YOUR_API_KEY_HERE"
# [现用] 主模型名（在 .env 中曾设为 glm-5）
MODEL_NAME="glm-5"


# -----------------------------------------------------------------------------
# LLM 服务（备用模型 - 智谱 GLM）
# 参考：test_env/test_plan.py 通过请求体字段传入；保留作为切换备选
# -----------------------------------------------------------------------------
# [现用] 智谱开放平台地址
BASE_URL_GLM="https://open.bigmodel.cn/api/paas/v4/"
# [现用] 智谱 API Key
API_KEY_GLM="your-zhipu-api-key-here"
# [现用] GLM 模型名
MODEL_NAME_GLM="glm-4.7"


# -----------------------------------------------------------------------------
# LLM 服务配置（推荐使用简洁名）
# 参考：test_env/test_plan.py、test_env/e2e_smoke_test.py 使用
# -----------------------------------------------------------------------------
# [推荐] 模型名（例：glm-4.5、kimi2.5、gpt-4o 等）
MODEL_NAME="glm-4.5"
# [推荐] LLM 网关地址
BASE_URL="https://open.bigmodel.cn/api/paas/v4/"
# [推荐] API Key
API_KEY=""

# [兼容旧名，可选] 若上面新名未设置，回退读取以下变量
# MODEL_NAME_KIMI2.5="kimi2.5"
# BASE_URL_WWCQ="https://open.bigmodel.cn/api/paas/v4/"
# API_KEY_WWCQ=""


# -----------------------------------------------------------------------------
# MCP 服务
# 参考：agent_tools/start_mcp_service.py:20 读取
# -----------------------------------------------------------------------------
# [现用] run_code MCP 工具的 HTTP 端口（仅在 transport=http 时生效；当前 default_config.json 用 stdio）
RUN_CODE_HTTP_PORT=9000


# -----------------------------------------------------------------------------
# RAG 检索
# 参考：RAG/RAG_main.py:57 读取
# -----------------------------------------------------------------------------
# [现用] 默认检索返回文档块数量
RAG_RETRIEVE_K=3

# [现用] Qwen3 嵌入模型本地路径（RAG_main.py 读取，默认回退到项目内 RAG/models/QwenEmbedding）
QWEN_EMBEDDING_PATH="D:/myLangchain/QwenEmbedding"

# [现用] Chroma 向量库持久化目录（RAG_main.py 读取，留空则使用项目根下 runtime/chroma）
CHROMA_DB_PATH=""

# [现用] RAG 知识库根目录（RAG_main.py 读取，默认回退到项目内 RAG/RAG_Data）
RAG_DATA_ROOT=""

# [现用] test_env 测试数据文件路径（test_plan.py 读取，命令行参数优先于本变量）
TEST_DATA_FILE=""


# -----------------------------------------------------------------------------
# Flask 服务（任务 I2 接线 Flask ↔ service_main 后启用）
# -----------------------------------------------------------------------------
# [现用] Flask 监听地址
FLASK_HOST="0.0.0.0"
# [现用] Flask 监听端口
FLASK_PORT=5000
# [现用] 是否开启 debug 模式（生产请设为 false）
FLASK_DEBUG=false
# [现用] HTTP 端点鉴权 key（请求头 X-API-Key；留空则不校验，生产必填）
SERVICE_API_KEY=""
# [现用] 请求体大小上限（字节，默认 50MB）
MAX_CONTENT_LENGTH=52428800
# [现用] 上传文件临时目录（留空用 runtime/uploads）
TEMP_UPLOAD_DIR=""
# [现用] 图表输出目录（留空用 runtime/charts）
CHARTS_DIR=""
# [现用] 后台任务线程池大小
TASK_MAX_WORKERS=2


# -----------------------------------------------------------------------------
# 会话与持久化（任务 M4 后启用）
# -----------------------------------------------------------------------------
# [待接-任务M4] 会话存储后端：sqlite | redis
SESSION_BACKEND="sqlite"
# [待接-任务M4] 会话存储目录（sqlite 模式下使用）
SESSION_STORE_DIR=".claude/sessions"
# [待接-任务M4] Redis 连接串（redis 模式下使用）
REDIS_URL="redis://localhost:6379/0"


# -----------------------------------------------------------------------------
# 记忆系统（任务 M2/M3 后启用）
# -----------------------------------------------------------------------------
# [待接-任务M3] 自动记忆目录（留空则使用 .claude/memory/<sanitized_project>/）
MEMORY_DIR=""
# [待接-任务M3] 记忆扫描文件数上限（参考 claude-code MAX_MEMORY_FILES=200）
MAX_MEMORY_FILES=200
# [待接-任务M3] MEMORY.md 入口文件字节上限（参考 claude-code MAX_ENTRYPOINT_BYTES=25000）
MAX_ENTRYPOINT_BYTES=25000


# -----------------------------------------------------------------------------
# Token 预算与压缩（任务 M6/M7 后启用）
# -----------------------------------------------------------------------------
# [待接-任务M6] 完成阈值：达到上下文窗口的多少比例即停止（参考 claude-code 0.9）
COMPLETION_THRESHOLD=0.9
# [待接-任务M6] 递减检测阈值：连续 N 次 delta token 少于此值视为卡住（参考 claude-code 500）
DIMINISHING_THRESHOLD=500
# [待接-任务M6] 递减检测连续次数（参考 claude-code 3）
DIMINISHING_CONTINUATION_COUNT=3
# [待接-任务M7] 是否禁用自动压缩（参考 claude-code DISABLE_AUTO_COMPACT）
DISABLE_AUTO_COMPACT=false


# -----------------------------------------------------------------------------
# 成本追踪（任务 T2 后启用）
# -----------------------------------------------------------------------------
# [待接-任务T2] 单次会话成本上限（人民币元），超出则停止
MAX_SESSION_COST_CNY=10.0


# -----------------------------------------------------------------------------
# 安全（任务 S2 后启用）
# -----------------------------------------------------------------------------
# [待接-任务S2] 沙箱模式：none | subprocess | docker
SANDBOX_MODE="subprocess"
# [待接-任务S2] 沙箱执行超时（秒）
SANDBOX_TIMEOUT_SECONDS=60
